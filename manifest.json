{
  "manifest_version": 3,
  "name": "Just The Answer",
  "short_name": "Just The Answer",
  "version": "1.1",
  "description": "Copy only the meaningful answer from AI responses. Clean and formatted for general pasting and using in Word and Google Docs",
  "author": "Supan Roy",
  "homepage_url": "https://github.com/Supan-Roy/Just-The-Answer",
  "permissions": ["clipboardWrite", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Just The Answer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://ai.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
